# 复制为 .env 后按需修改。注意：变量名带 APP_ 前缀。
APP_ENV=local
APP_DATABASE_URL=sqlite+aiosqlite:///./app.db
APP_LOG_LEVEL=INFO
# 逗号分隔；留空则不启用 CORS
APP_CORS_ORIGINS=http://localhost:3000

# ---- 大模型（W2）----
# 去对应厂商控制台申请。不配置也能启动，只有调用 /assistant 接口时才会报错。
APP_LLM_API_KEY=
# 默认 MiniMax（OpenAI 兼容）；换成任何兼容接口即可
APP_LLM_BASE_URL=https://api.minimax.chat/v1
APP_LLM_MODEL=MiniMax-M3
APP_LLM_TIMEOUT=30
APP_LLM_MAX_RETRIES=2
# MiniMax 专用：关闭思考链。别家接口不认这个参数时设为 false
APP_LLM_DISABLE_THINKING=true
APP_ASSISTANT_MAX_STEPS=5
